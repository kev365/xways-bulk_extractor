#include <windows.h>
#include "resource.h"

// v0.3.0 layout iteration:
//   - "Output directory:" moved from a standalone full-width row at the
//     top into the Output handling group (since picking *where* the run
//     writes is conceptually part of "what we do with the output"). New
//     order inside the group: Output directory → Add to case → Open
//     folder.
//   - All controls below the deleted standalone row shift up by 28 DLU
//     (BE binary, Scanners group, Reset/Toggle, Output handling group,
//     Threads/Max recursion). Output handling group grew from h=44 to
//     h=72 to accommodate the new label + edit + browse row.
//   - Threads/Max recursion are now parallel with the *checkboxes* at the
//     bottom of Output handling rather than the path edit at the top —
//     keeps the right-column controls visually grouped with action items.
//   - The cpp's kShiftIds was extended to include the moved output-dir
//     controls so the auto-fit shrink/shift logic still works correctly.
//
// v0.2.18 layout iteration (kept for archaeology):
//   - Threads + Max recursion moved from a full-width row at the bottom to
//     a vertically-stacked pair on the RIGHT of the Output handling group
//     (parallel to it, like Reset/Toggle next to Scanners).
//   - Scanners group title trimmed from "Scanners (default = bulk_extractor's
//     defaults; check to enable, uncheck to disable)" to just "Scanners".
//   - GROUPBOX titles are programmatically given a bold + slightly larger
//     (11pt) font in WM_INITDIALOG for visual emphasis. Done in C++ rather
//     than .rc since RC dialog templates carry only one font directive.
//
// v0.2.7+: dialog font 10pt for non-scanner controls; scanner checkboxes
// programmatically created with their own 9pt font for density.
IDD_SETTINGS DIALOGEX 0, 0, 400, 512
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "bulk_extractor - Settings"
FONT 10, "MS Shell Dlg"
BEGIN
    // -------- bulk_extractor binary (v0.5.0: moved to the top) ----------
    // Row 1: "Version:" + blue detected-version readout (mode-aware: the
    // Windows binary's --version banner, or the WSL detection status) and
    // the right-justified WSL toggle. Row 2: path edit + Browse. When
    // IDC_CHK_USE_WSL is checked the edit holds a Linux path.
    GROUPBOX        "bulk_extractor binary",                            IDC_GROUP_BINARY,           7,   4, 386,  48
    LTEXT           "Version:",                                         IDC_LABEL_BE_BIN,          14,  17,  34,   8
    LTEXT           "",                                                 IDC_STATIC_WSL_VERSION,    50,  17, 190,   8, SS_NOTIFY
    AUTOCHECKBOX    "Run via WSL (use Linux bulk_extractor)",           IDC_CHK_USE_WSL,          251,  16, 135,  10
    EDITTEXT                                                            IDC_EDIT_BE_BIN,           14,  31, 318,  12, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",                                        IDC_BTN_BROWSE_BE,        336,  30,  47,  14

    // -------- Input source group (with tagging sub-options nested) --------
    GROUPBOX        "Input source",                                     IDC_GROUP_INPUT,            7,  58, 386, 131
    AUTORADIOBUTTON "&Active evidence object's source image",           IDC_RADIO_INPUT_EVOIMAGE,  14,  70, 180,  10, WS_GROUP | WS_TABSTOP
    LTEXT           "",                                                 IDC_STATIC_EO_HINT,       196,  70, 190,  10
    AUTORADIOBUTTON "&External file or directory (exported data or data not in the case):",
                                                                        IDC_RADIO_INPUT_PICK,      14,  83, 372,  10
    EDITTEXT                                                            IDC_EDIT_INPUT_PATH,       24,  95, 265,  12, ES_AUTOHSCROLL
    PUSHBUTTON      "File...",                                          IDC_BTN_BROWSE_INPUT_FILE,292,  94,  47,  14
    PUSHBUTTON      "Folder...",                                        IDC_BTN_BROWSE_INPUT_DIR, 342,  94,  47,  14
    AUTORADIOBUTTON "Use &selected items in directory browser",         IDC_RADIO_INPUT_SELECTED,  14, 112, 180,  10
    LTEXT           "",                                                 IDC_STATIC_SELECTED_COUNT,196, 112, 190,  10

    // Tag sub-options -- only meaningful with "Use selected items..." radio.
    // v0.5.0: "Label" wording (X-Ways' term), short "BE" names, and the
    // per-scanner labels are the primary hit labels — the umbrella "BE hits"
    // is the optional sub-option.
    AUTOCHECKBOX    "Label scanned source items ""BE scanned""",
                                                                        IDC_CHK_TAG_SCANNED,       24, 128, 360,  10
    AUTOCHECKBOX    "Label items with feature hits per scanner (""BE: email"", ""BE: net"", ...)",
                                                                        IDC_CHK_TAG_HITS,          24, 142, 360,  10
    AUTOCHECKBOX    "Also add one umbrella ""BE hits"" label to every item with any hit",
                                                                        IDC_CHK_TAG_HITS_UMBRELLA, 34, 156, 350, 10

    // v0.5.0: what a Run will actually feed to bulk_extractor, with size
    // (file: name + size; directory: name + bounded file count + size;
    // selected items: count + total size). Refreshed by UpdateScanTarget.
    LTEXT           "Scan target:",                                     IDC_LABEL_SCAN_TARGET,     14, 173,  48,   8
    LTEXT           "",                                                 IDC_STATIC_SCAN_TARGET,    64, 173, 322,   8, SS_NOTIFY

    // -------- Scanners group + right column --------
    // Checkboxes are created programmatically (4 columns, column-major,
    // font-derived row height); the group is auto-shrunk to fit and
    // everything below shifts up (kShiftIds). Threads / Max recursion have
    // placeholder y here and are snapped to sit directly above the Output
    // handling group after the auto-fit.
    // WS_GROUP closes the input-source radio group (radio1 opened it).
    GROUPBOX        "Scanners",                                         IDC_GROUP_SCANNERS,         7, 197, 283, 196, WS_GROUP
    PUSHBUTTON      "Reset to defaults",                                IDC_BTN_RESET_SCANNERS,   297, 209,  96,  16
    PUSHBUTTON      "Check / Uncheck all",                              IDC_BTN_TOGGLE_ALL,       297, 229,  96,  16
    LTEXT           "Threads:",                                         IDC_LABEL_THREADS,        297, 255,  50,   8
    COMBOBOX                                                            IDC_COMBO_THREADS,        350, 253,  43, 200, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Max recursion:",                                   IDC_LABEL_MAXRECURSE,     297, 271,  55,   8
    EDITTEXT                                                            IDC_EDIT_MAXRECURSE,      355, 269,  38,  12, ES_AUTOHSCROLL | ES_NUMBER

    // -------- Output handling (full width) --------
    GROUPBOX        "Output handling",                                  IDC_GROUP_OUTPUT,           7, 401, 386,  72
    LTEXT           "Output directory:",                                IDC_LABEL_OUTPUT,          14, 415,  80,   8
    EDITTEXT                                                            IDC_EDIT_OUTPUT_DIR,       14, 425, 318,  12, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",                                        IDC_BTN_BROWSE_OUTPUT,    336, 424,  47,  14
    AUTOCHECKBOX    "Add output directory to X-Ways case as evidence object (Directory)",
                                                                        IDC_CHK_ADD_TO_CASE,       14, 445, 366,  10
    AUTOCHECKBOX    "Open output folder in Explorer when done",         IDC_CHK_OPEN_FOLDER,       14, 459, 366,  10

    // -------- Bottom: status/progress bar, then About / Open output | Run / Cancel
    // The status bar is owner-drawn (DrawStatusBar): idle track, marquee
    // while running, soft fill when done, red flash on helper rejection.
    // Run/Cancel are owner-draw for the Ctrl-to-save gesture (DM_SETDEFID
    // keeps Enter on Run).
    CONTROL         "",                                                 IDC_STATIC_BE_STATUS,     "Static", SS_OWNERDRAW | SS_NOTIFY | WS_CHILD | WS_VISIBLE, 7, 478, 386, 12
    PUSHBUTTON      "About",                                            IDC_BTN_ABOUT,              7, 494,  45,  14
    PUSHBUTTON      "Open output",                                      IDC_BTN_OPEN_OUTPUT,       56, 494,  60,  14
    PUSHBUTTON      "Run",                                              IDOK,                     283, 494,  50,  14, BS_OWNERDRAW
    PUSHBUTTON      "Cancel",                                           IDCANCEL,                 339, 494,  50,  14, BS_OWNERDRAW
END

// =============================================================================
//  About dialog (v0.5.0) -- mirrors xways-ual-timeliner / xways-updater: bold
//  title, description, bold "Author:" prefix, clickable URL buttons, coffee CTA.
// =============================================================================
IDD_ABOUT DIALOGEX 0, 0, 300, 158
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About xways-bulk_extractor"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT     "xways-bulk_extractor",                             IDC_ABOUT_TITLE,        12,  10, 276, 12
    LTEXT     "",                                                 IDC_ABOUT_DESC,         12,  26, 276, 18
    LTEXT     "Author:",                                          IDC_ABOUT_LABEL_AUTHOR_PREFIX, 12, 50,  30, 9
    LTEXT     "",                                                 IDC_ABOUT_AUTHOR,       44,  50, 244,  9
    PUSHBUTTON "https://github.com/kev365/xways-bulk_extractor",  IDC_ABOUT_LINK_GITHUB,  12,  64, 276, 14
    PUSHBUTTON "https://github.com/simsong/bulk_extractor",       IDC_ABOUT_LINK_TOOL,    12,  82, 276, 14
    PUSHBUTTON "https://www.linkedin.com/in/dfir-kev",            IDC_ABOUT_LINK_LINKEDIN, 12, 100, 276, 14
    PUSHBUTTON "Buy me a coffee",                                 IDC_ABOUT_BTN_COFFEE,   12, 118, 276, 14
    DEFPUSHBUTTON "OK",                                           IDOK,                  238, 140,  50, 14
END

// =============================================================================
//  Version resource -- keep FILEVERSION/strings in sync with VERSION in the
//  .cpp and the README (versioning convention).
// =============================================================================
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,5,0,0
 PRODUCTVERSION 0,5,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Kevin Stokes"
            VALUE "FileDescription",  "bulk_extractor wrapper for X-Ways Forensics"
            VALUE "FileVersion",      "0.5.0-beta"
            VALUE "InternalName",     "xways-bulk_extractor"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Kevin Stokes. MIT License."
            VALUE "OriginalFilename", "xways-bulk_extractor.dll"
            VALUE "ProductName",      "xways-bulk_extractor"
            VALUE "ProductVersion",   "0.5.0-beta"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
