# =============================================================================
#  xways-bulk_extractor — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
#  MSVC / C++ build artifacts (regenerated by build.bat)
# -----------------------------------------------------------------------------
*.obj
*.lib
*.exp
*.res
*.dll
*.pdb
*.ilk
*.idb

# -----------------------------------------------------------------------------
#  Deployment bundle. build.bat regenerates xtensions\xways-bulk_extractor\
#  with the freshly-built DLL. We deliberately do NOT track it:
#    - the DLL is shipped via GitHub Releases, not in git (kept local for now;
#      revisit when the repo goes public);
#    - bulk_extractor64.exe is upstream's ~86 MB redistributable — the README
#      documents where to download it;
#    - temp\ holds full-byte copies of selected items during a run.
#  Build locally to produce the bundle.
# -----------------------------------------------------------------------------
xtensions/

# -----------------------------------------------------------------------------
#  Live sidecar config (per-analyst paths/settings). The committed
#  *.cfg.example documents the keys; the live *.cfg next to the DLL doesn't ship.
# -----------------------------------------------------------------------------
*.cfg
!*.cfg.example

# -----------------------------------------------------------------------------
#  Release / archive blobs kept locally, not committed
# -----------------------------------------------------------------------------
*.zip
*.7z
*.bak

# -----------------------------------------------------------------------------
#  Visual Studio / IDE state
# -----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.suo
*.user
*.ntvs*
*.njsproj
*.sln.iml

# -----------------------------------------------------------------------------
#  OS metadata
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# -----------------------------------------------------------------------------
#  Claude Code local config
# -----------------------------------------------------------------------------
CLAUDE.md
.claude/

# -----------------------------------------------------------------------------
#  Planning notes kept local, not published. The README carries the
#  user-facing "Current limitations"; the roadmap behind them is working
#  material (priorities, half-finished investigations, upstream gripes) and
#  is not part of what ships.
# -----------------------------------------------------------------------------
ROADMAP.md
